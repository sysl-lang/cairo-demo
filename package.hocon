// The worked example for `sh.sysl.cairo` — one drawing, four backends.
//
// It depends on one package and carries no files of its own: no font, no image, no data file. The
// only thing it reads is the coordinate below, and the only things it writes are its own output.

package {
  name    = "cairo-demo"
  version = "0.3.0"
}

dependencies {
  cairo { git = "github.com/sysl-lang/cairo", version = "0.3.0" }
}

requires {
  os    = true
  heap  = true
}
